+inline const char *repro_order_mode(const char *kernel) {
+    const char *mode=std::getenv("PPF_REPRO_ORDER_MODE");
+    if (!mode || (!std::strcmp(mode,"parallel"))) return nullptr;
+    if (std::strcmp(mode,"serial") && std::strcmp(mode,"colored"))
+        throw std::runtime_error("unknown research accumulation mode");
+    const char *filter=std::getenv("PPF_REPRO_ORDER_FILTER");
+    if (!filter) filter="face_elastic_embed_from_records";
+    bool enabled=(!std::strcmp(filter,"all") || !std::strcmp(filter,kernel));
+    if(enabled && std::getenv("PPF_REPRO_ORDER_TRACE")) std::fprintf(stderr,"REPRO_ORDER %s %s\n",kernel,mode);
+    return enabled ? mode : nullptr;
+}
+
+inline void repro_cuda_check(cudaError_t status) {
+    if(status!=cudaSuccess)throw std::runtime_error(cudaGetErrorString(status));
+}
+// High-water storage belongs to a stream/kernel, not to an individual Newton
+// assembly. Scratch views are refreshed in full; color reuse compares indices.
+struct ReproCacheEntry {
+    std::vector<void *> blocks,active_blocks;
+    std::vector<size_t> capacities;
+    void *table=nullptr,*flags=nullptr,*order=nullptr;
+    size_t table_bytes=0,flag_bytes=0,order_bytes=0;
+    std::vector<unsigned> host_order,host_flags,stencil,offsets;
+    unsigned arity=0,bound=0;
+    static void ensure(void *&pointer,size_t &capacity,size_t bytes) {
+        if(capacity>=bytes)return;
+        void *fresh=nullptr;repro_cuda_check(cudaMalloc(&fresh,bytes));
+        if(pointer)cudaFree(pointer);pointer=fresh;capacity=bytes;
+    }
