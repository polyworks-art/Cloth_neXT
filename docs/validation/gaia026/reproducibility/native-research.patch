+// Research-only opt-in state capture. Absent PPF_REPRO_DIR this does no I/O.
+fn repro_checkpoint<D: ppf_cts_compute::Device>(device: &mut D, state: &mut SolverState,
+    fixed: &mut FixedCsr<'_>, stage: &str) -> FatalResult<()> {
+    use std::sync::atomic::{AtomicUsize,Ordering};
+    static ITERATION: AtomicUsize = AtomicUsize::new(0);
+    let Some(dir)=std::env::var_os("PPF_REPRO_DIR") else { return Ok(()); };
+    let iteration=if stage=="momentum" {ITERATION.fetch_add(1,Ordering::SeqCst)+1} else {ITERATION.load(Ordering::SeqCst)};
+    let count=std::env::var("PPF_REPRO_ITERATIONS").ok().and_then(|s|s.parse::<usize>().ok()).unwrap_or(1);
+    if iteration>count {return Ok(());}
+    let path=std::path::Path::new(&dir);
+    std::fs::create_dir_all(path).map_err(|e|Fatal::invariant(format!("repro directory: {e}")))?;
+    if stage=="momentum" {
+        state.positions.download(device)?;state.eval_x.download(device)?;state.target.download(device)?;
+        for (name,values) in [("positions",state.positions.host()),("eval_x",state.eval_x.host()),("target",state.target.host())] {
+            std::fs::write(path.join(format!("{iteration:03}-{stage}-{name}.f32")),bytemuck::cast_slice(values)).map_err(|e|Fatal::invariant(format!("repro input capture: {e}")))?;
+        }
+        std::fs::write(path.join(format!("{iteration:03}-{stage}-vertex_props.json")),serde_json::to_vec(state.prop_vertex.host()).map_err(|e|Fatal::invariant(format!("repro property encoding: {e}")))?).map_err(|e|Fatal::invariant(format!("repro property capture: {e}")))?;
+        let material=serde_json::json!({"face_prop":state.prop_face.host(),"face_param":state.param_face.host(),"hinge_prop":state.prop_hinge.host(),"hinge_param":state.param_hinge.host(),"hinge_remapped":state.hinge.remapped.host()});
+        std::fs::write(path.join(format!("{iteration:03}-{stage}-material_records.json")),serde_json::to_vec(&material).map_err(|e|Fatal::invariant(format!("repro material encoding: {e}")))?).map_err(|e|Fatal::invariant(format!("repro material capture: {e}")))?;
+    }
+    state.eval_x.download(device)?;state.positions.download(device)?;
+    state.force.download(device)?;
+    fixed.download(device)?;
+    if stage=="contact" || stage=="dirichlet" {
+        if let Some(contact)=state.contact.as_ref() {
+            let flat=&contact.flat;
+            let mut offsets=vec![0u32;flat.rows+1];
+            let mut indices=vec![0u32;flat.nnz];
+            let mut values=vec![0f32;9*flat.nnz];
+            flat.offset.read(device,0,&mut offsets)?;
+            flat.index.read(device,0,&mut indices)?;
+            flat.value.read(device,0,&mut values)?;
+            for (name,bytes) in [("dynamic-offset",bytemuck::cast_slice(offsets.as_slice())),("dynamic-index",bytemuck::cast_slice(indices.as_slice())),("dynamic-value",bytemuck::cast_slice(values.as_slice()))] {
+                std::fs::write(path.join(format!("{iteration:03}-{stage}-{name}.bin")),bytes).map_err(|e|Fatal::invariant(format!("repro dynamic capture: {e}")))?;
+            }
+            let transpose=&contact.transpose;
+            let mut offsets=vec![0u32;flat.rows+1];
+            let mut indices=vec![0u32;transpose.total];
+            let mut values=vec![0u32;transpose.total];
+            transpose.offset.read(device,0,&mut offsets)?;
+            transpose.index.read(device,0,&mut indices)?;
+            transpose.value.read(device,0,&mut values)?;
+            for (name,words) in [("transpose-offset",offsets.as_slice()),("transpose-index",indices.as_slice()),("transpose-value",values.as_slice())] {
+                std::fs::write(path.join(format!("{iteration:03}-{stage}-{name}.bin")),bytemuck::cast_slice(words)).map_err(|e|Fatal::invariant(format!("repro transpose capture: {e}")))?;
+            }
+        }
+    }
+    let mut dx=vec![0f32;state.dx.len()];state.dx.read(device,0,&mut dx)?;
+    let mut diagonal=vec![0f32;state.diagonal.len()];state.diagonal.read(device,0,&mut diagonal)?;
+    for (name,values) in [("force",state.force.host()),("fixed",fixed.values()),("diagonal",diagonal.as_slice()),("dx",dx.as_slice()),("eval_x",state.eval_x.host()),("positions",state.positions.host())] {
+        let file=path.join(format!("{iteration:03}-{stage}-{name}.f32"));
+        std::fs::write(file,bytemuck::cast_slice(values)).map_err(|e|Fatal::invariant(format!("repro capture: {e}")))?;
+    }
+    if stage=="linear_solve" && std::env::var_os("PPF_REPRO_STOP_AFTER_FIRST_SOLVE").is_some() {
+        return Err(Fatal::invariant("REPRO_EXPECTED_STOP_AFTER_FIRST_SOLVE"));
+    }
+    Ok(())
+}
