+// Scratch copies are used only to identify queries that actually contribute.
+// They never replace the live assembly. The original traversal runs again, in
+// ascending query order, for every contributing or overlap-reporting query.
+static __global__ void repro_copy_span(ArenaHandle handle,void *destination,size_t words) {
+    size_t i=blockIdx.x*blockDim.x+threadIdx.x;
+    if(i<words) static_cast<unsigned *>(destination)[i]=compute::arena::resolve_const<unsigned>(handle)[i];
+}
+struct ReproScratchSpan {ArenaHandle handle;size_t element_bytes;};
+struct ReproContactScratch {
+    ReproCacheEntry &cache;
+    void **table=nullptr;
+    unsigned *flags=nullptr,*order=nullptr;
+    unsigned count=0;
+    cudaStream_t queue;
+    static void check(cudaError_t status) {
+        if(status!=cudaSuccess) throw std::runtime_error(cudaGetErrorString(status));
+    }
+    ReproContactScratch(std::initializer_list<ReproScratchSpan> handles,unsigned queries,cudaStream_t stream,const char *kernel)
+        :cache(repro_cache(stream,std::string("contact:")+kernel)),count(queries),queue(stream) {
+        cache.blocks.resize(handles.size(),nullptr);cache.capacities.resize(handles.size(),0);
+        cache.active_blocks.clear();size_t k=0;
+        for(const auto &span:handles) {
+            const auto &handle=span.handle;
+            if(!handle.size) {cache.active_blocks.push_back(nullptr);++k;continue;}
+            // Exact typed view size, including nonzero-offset staging spans.
+            // Original record handles are validated before this launcher runs.
+            size_t bytes=static_cast<size_t>(handle.size)*span.element_bytes;
+            if(bytes%sizeof(unsigned)) throw std::runtime_error("unaligned contact scratch span");
+            ReproCacheEntry::ensure(cache.blocks[k],cache.capacities[k],bytes);
+            size_t words=bytes/sizeof(unsigned);
+            repro_copy_span<<<static_cast<unsigned>((words+255)/256),256,0,queue>>>(handle,cache.blocks[k],words);
+            check(cudaGetLastError());cache.active_blocks.push_back(cache.blocks[k]);++k;
+        }
+        ReproCacheEntry::ensure(cache.table,cache.table_bytes,handles.size()*sizeof(void *));
+        ReproCacheEntry::ensure(cache.flags,cache.flag_bytes,queries*sizeof(unsigned));
+        table=static_cast<void **>(cache.table);flags=static_cast<unsigned *>(cache.flags);
+        check(cudaMemcpyAsync(table,cache.active_blocks.data(),handles.size()*sizeof(void *),cudaMemcpyHostToDevice,queue));
+        check(cudaMemsetAsync(flags,0,queries*sizeof(unsigned),queue));
+    }
+    unsigned select() {
+        cache.host_flags.resize(count);cache.host_order.clear();
+        check(cudaMemcpy(cache.host_flags.data(),flags,count*sizeof(unsigned),cudaMemcpyDeviceToHost));
+        for(unsigned i=0;i<count;++i) if(cache.host_flags[i])cache.host_order.push_back(i);
+        if(!cache.host_order.empty()) {
+            ReproCacheEntry::ensure(cache.order,cache.order_bytes,cache.host_order.size()*sizeof(unsigned));
+            check(cudaMemcpyAsync(cache.order,cache.host_order.data(),cache.host_order.size()*sizeof(unsigned),cudaMemcpyHostToDevice,queue));
+        }
+        order=static_cast<unsigned *>(cache.order);
+        if(std::getenv("PPF_REPRO_ORDER_TRACE")) std::fprintf(stderr,"REPRO_CONTACT_SELECT %zu/%u\n",cache.host_order.size(),count);
+        return static_cast<unsigned>(cache.host_order.size());
+    }
+    ReproContactScratch(const ReproContactScratch &)=delete;
+};
