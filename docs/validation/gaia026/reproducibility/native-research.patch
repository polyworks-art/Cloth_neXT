+        cache.stencil=std::move(input);cache.arity=arity;cache.bound=bound;cache.offsets=offsets;
+        device=static_cast<unsigned *>(cache.order);
+    }
+    ReproColorOrder(const ReproColorOrder &)=delete;
+};
