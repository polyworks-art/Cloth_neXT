+fn repro_solution<D: ppf_cts_compute::Device>(device: &mut D, dx: &ppf_cts_compute::Buffer<f32>) -> FatalResult<()> {
+    use std::sync::atomic::{AtomicUsize,Ordering};
+    static SOLVE: AtomicUsize=AtomicUsize::new(0);
+    let Some(dir)=std::env::var_os("PPF_REPRO_DIR") else {return Ok(());};
+    let iteration=SOLVE.fetch_add(1,Ordering::SeqCst)+1;
+    let count=std::env::var("PPF_REPRO_ITERATIONS").ok().and_then(|s|s.parse::<usize>().ok()).unwrap_or(1);
+    if iteration>count {return Ok(());}
+    let mut values=vec![0f32;dx.len()];dx.read(device,0,&mut values)?;
+    std::fs::write(std::path::Path::new(&dir).join(format!("{iteration:03}-linear_solve-dx.f32")),bytemuck::cast_slice(values.as_slice())).map_err(|e|Fatal::invariant(format!("repro solve capture: {e}")))?;
+    if std::env::var_os("PPF_REPRO_STOP_AFTER_FIRST_SOLVE").is_some() {return Err(Fatal::invariant("REPRO_EXPECTED_STOP_AFTER_FIRST_SOLVE"));}
+    Ok(())
