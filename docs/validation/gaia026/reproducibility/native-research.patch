+            std::vector<unsigned char> forbidden(bins.size()+1,0);
+            for (unsigned j=0;j<arity;++j) {
+                unsigned v=input[static_cast<size_t>(element)*arity+j];
+                if (v>=bound) throw std::runtime_error("research color index exceeds declared vertex bound");
+                for (unsigned color:used[v]) forbidden[color]=1;
+            }
+            unsigned color=0;while (forbidden[color]) ++color;
+            if (color==bins.size()) bins.emplace_back();
+            bins[color].push_back(element);
+            for (unsigned j=0;j<arity;++j) {
+                auto &colors=used[input[static_cast<size_t>(element)*arity+j]];
+                if (std::find(colors.begin(),colors.end(),color)==colors.end()) colors.push_back(color);
+            }
+        }
+        if(std::getenv("PPF_REPRO_ORDER_TRACE")) std::fprintf(stderr,"REPRO_COLORS elements=%u arity=%u colors=%zu\n",count,arity,bins.size());
+        std::vector<unsigned> order;order.reserve(count);offsets.push_back(0);
+        for (const auto &bin:bins) {order.insert(order.end(),bin.begin(),bin.end());offsets.push_back(static_cast<unsigned>(order.size()));}
+        cache.host_order=std::move(order);
+        ReproCacheEntry::ensure(cache.order,cache.order_bytes,cache.host_order.size()*sizeof(unsigned));
