+def _research_fast_contact(entry):
+    """Parallel count/record passes reproducing the serial reference order exactly.
+
+    Same hoisted handles and the same unchanged body call as the select probe.
+    Count: every mutable handle on the scratch copies, dyn_claim on a per-query
+    counter, float atomics counted by the research hook. Record: live handles,
+    dyn_claim on the per-query counter seeded with the serial slot base, float
+    atomics logged by the hook and applied after a stable sort by address.
+    """
+    mutable=[f for f in entry.fields if f.kind=="handle" and not f.is_const]
+    assert any(f.name=="dyn_claim" for f in mutable), entry.name
+    count=entry.count_field.name;idx=entry.index_name;diag=_diag_cu_arg(entry)
+    out=[]
+    for mode in ("count","record"):
+        extra=", void **scratch" if mode=="count" else ""
+        out.append(f'\n__global__ void {entry.entry_symbol}_fast{mode}({entry.record_cpp} args{extra}, unsigned *claims{_diag_cu_param(entry)}) {{\n')
+        out.append(f'    unsigned {idx}=blockIdx.x*blockDim.x+threadIdx.x;\n    if({idx}>=args.{count}) return;\n')
+        out.append(_diag_cu_bind(entry));out.extend(_hoist(entry,_resolve_cu,"args.",0))
+        for k,f in enumerate(mutable):
+            if f.name=="dyn_claim":
+                out.append(f'    static_assert(sizeof(compute::atomic_uint_t)==sizeof(unsigned));\n    dyn_claim=reinterpret_cast<compute::atomic_uint_t *>(claims+{idx});\n')
+            elif mode=="count":
