+    unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n || (i > 0 && key[i] == key[i - 1]) || key[i] == 0ull) return;
+    unsigned *counter = reinterpret_cast<unsigned *>(key[i]);
