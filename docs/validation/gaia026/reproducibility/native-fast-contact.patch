+// ---------------------------------------------------------------------------
+// PPF_REPRO_FAST_CONTACT: parallel execution with the serial reference's exact
+// accumulation order. Count pass (scratch buffers): per query, float atomic
+// contributions and dynamic slot claims. Record pass (live buffers, original
+// body): claims use a per-query counter seeded with the slot the ascending
+// serial execution would hand out; float atomics are logged at the query's
+// offset in body order. A stable sort by address followed by one sequential
+// atomicAdd chain per address reproduces the serial per-address order exactly.
+#include "seam_cuda.cuh"
+#include <cub/device/device_scan.cuh>
+#include <cub/device/device_merge_sort.cuh>
+// DeviceRadixSort fails ("invalid argument") in this lto_61 device-link build;
+// the stable merge sort is verified working under the same flags.
+struct ReproAddressLess {__device__ bool operator()(unsigned long long a, unsigned long long b) const {return a < b;}};
+
+static __global__ void repro_set_record_context(compute::ReproRecordContext *context) {
+    compute::g_repro_record = context;
+}
+static __global__ void repro_seed_claims(ArenaHandle dyn_claim_handle, const unsigned *prefix,
+                                         const unsigned *counts, unsigned *seeded, unsigned count) {
+    unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= count) return;
+    auto *dyn_claim = compute::arena::resolve<compute::atomic_uint_t>(dyn_claim_handle);
+    const unsigned start = compute::atomic_load(dyn_claim);
+    seeded[i] = start + prefix[i];
+}
+static __global__ void repro_finish_claims(ArenaHandle dyn_claim_handle, const unsigned *prefix,
+                                           const unsigned *counts, unsigned count) {
+    auto *dyn_claim = compute::arena::resolve<compute::atomic_uint_t>(dyn_claim_handle);
+    // Advance by the total, exactly what the serial claims leave behind.
+    compute::atomic_add(dyn_claim, prefix[count - 1] + counts[count - 1]);
+}
+static __global__ void repro_verify_cursors(const unsigned *cursor, const unsigned *offset, const unsigned *counts,
+                                            unsigned count, unsigned *mismatch) {
+    unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < count && cursor[i] != offset[i] + counts[i]) atomicExch(mismatch, 1u);
+}
+static __global__ void repro_apply_log(const unsigned long long *address, const float *value, unsigned count) {
+    unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= count || (i > 0 && address[i] == address[i - 1])) return;
+    float *target = reinterpret_cast<float *>(address[i]);
+    for (unsigned j = i; j < count && address[j] == address[i]; ++j) atomicAdd(target, value[j]);
+}
