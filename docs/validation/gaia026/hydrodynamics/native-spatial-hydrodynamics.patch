+/// Isolated experiment: prescribed uniform SI flow and known area fraction.
+/// Not a FluidVolume/occupancy adapter. Existing material/contact terms remain.
+#[derive(Clone, Copy, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct HydroTest {
+    pub density_kg_m3: f32,
+    pub normal_coefficient: f32,
+    pub tangential_coefficient: f32,
+    pub wet_area_fraction: f32,
+    pub velocity_m_s: [f32;3],
+    #[serde(default)]
+    pub volume_mode: u32,
+}
+
+pub unsafe fn hydrodynamic_test<D: Device>(device: &mut D, data: &DataSet,
+    state: &mut SolverState, fixed: &mut FixedCsr<'_>, dt:f32, time:f32) -> FatalResult<()> {
+    let Some(path) = std::env::var_os("PPF_EXPERIMENTAL_HYDRO_TEST_JSON") else { return Ok(()); };
+    let text = std::fs::read_to_string(&path).map_err(|e| Fatal::invariant(format!("hydrodynamic test config: {e}")))?;
+    let h: HydroTest = serde_json::from_str(&text).map_err(|e| Fatal::invariant(format!("hydrodynamic test config: {e}")))?;
+    let values=[h.density_kg_m3,h.normal_coefficient,h.tangential_coefficient,h.wet_area_fraction];
+    if values.iter().any(|v| !v.is_finite() || *v<0.0) || h.wet_area_fraction>1.0 || h.velocity_m_s.iter().any(|v| !v.is_finite()) || !(dt>0.0 && dt.is_finite()) {
+        return Err(Fatal::invariant("invalid SI hydrodynamic test inputs"));
+    }
+    if state.field.has_active_fluid_flow() {
+        return Err(Fatal::invariant("hydrodynamics: simultaneous legacy Fluid Flow is refused"));
+    }
+    if h.volume_mode>1 {return Err(Fatal::invariant("hydrodynamics: invalid volume mode"));}
+    if h.volume_mode==1 {
+        state.hydro_field.hydrodynamic_volumes(device,time)?;
+    }
+    state.hydro_last_time=time;
+    state.hydro_last_dt=dt;
+    // This experiment deliberately only accepts scenes authored in SI metres.
+    shell_face_pass(device,data,0.0,state,fixed,dt,Some(h))
+}
