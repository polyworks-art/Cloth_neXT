+/// Last native hydrodynamic assembly at each output frame, in face order.
+pub(crate) fn export_hydrodynamics(path:&std::path::Path) {
+    if std::env::var_os("PPF_EXPERIMENTAL_HYDRO_VOLUME_DIR").is_none(){return;}
+    let mut guard=SOLVER.lock().unwrap();
+    let state=guard.as_mut().unwrap();
+    if let Err(fatal)=with_device(|device| {
+        state.hydro_telemetry.download(device)?;
+        let mut io=state.hydro_field.hydrodynamic_io();
+        io["evaluation_time_s"]=serde_json::json!(state.hydro_last_time);
+        io["dt_s"]=serde_json::json!(state.hydro_last_dt);
+        std::fs::write(path.with_extension("io.json"),io.to_string())
+            .map_err(|e|Fatal::invariant(format!("hydrodynamic I/O telemetry: {e}")))?;
+        std::fs::write(path,bytemuck::cast_slice(state.hydro_telemetry.host()))
+            .map_err(|e|Fatal::invariant(format!("hydrodynamic telemetry: {e}")))?;
+        Ok(())
+    }) {drop(guard);fatal_exit(fatal);}
