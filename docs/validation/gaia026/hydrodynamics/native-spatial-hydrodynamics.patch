+    /// Experimental typed transport reuses only the verified brick storage and
+    /// two-frame residency. It is never installed as an acceleration field.
+    pub fn hydrodynamic_volumes(&mut self, device:&mut impl Device, time:f32)
+        -> FatalResult<[Handle;4]> {
+        if !self.installed {
+            let root=std::env::var_os("PPF_EXPERIMENTAL_HYDRO_VOLUME_DIR")
+                .ok_or_else(|| Fatal::invariant("hydrodynamics: missing volume directory"))?;
+            let dir=std::path::Path::new(&root);
+            let meta:serde_json::Value=serde_json::from_str(&std::fs::read_to_string(dir.join("hydrodynamics.json"))
+                .map_err(|e|Fatal::invariant(format!("hydrodynamics manifest: {e}")))?)
+                .map_err(|e|Fatal::invariant(format!("hydrodynamics manifest: {e}")))?;
+            if meta["version"]!=1 || meta["roles"]!=serde_json::json!(["velocity_m_s_support","signed_distance_m_x_identity"])
+                || meta["units"]!="metre_second" {
+                return Err(Fatal::invariant("hydrodynamics: incompatible typed volume manifest"));
+            }
+            let data=crate::force_field::load_dir(dir,self.vertices)
+                .map_err(Fatal::invariant)?.ok_or_else(||Fatal::invariant("hydrodynamics: missing brick manifest"))?;
+            if data.fields.len()!=2 || !data.scripts.is_empty() {
+                return Err(Fatal::invariant("hydrodynamics: exactly velocity and SDF volumes required"));
+            }
+            let a=data.fields[0].fluid.as_ref().ok_or_else(||Fatal::invariant("hydrodynamics: missing velocity"))?;
+            let b=data.fields[1].fluid.as_ref().ok_or_else(||Fatal::invariant("hydrodynamics: missing SDF"))?;
+            if a.start!=b.start || a.step!=b.step || a.frames()!=b.frames() || a.frames()<2 {
+                return Err(Fatal::invariant("hydrodynamics: velocity/SDF clocks disagree"));
+            }
+            for k in 0..b.frames() {
+                for c in 0..3 {
+                    let expected=std::array::from_fn(|j|if c==j {1.0} else {0.0});
+                    if b.axis(k,c)!=expected {return Err(Fatal::invariant("hydrodynamics: SDF axes must be identity"));}
+                }
+                if b.is_empty_frame(k) {return Err(Fatal::invariant("hydrodynamics: missing SDF frame"));}
+            }
+            self.install(device,&data,1.0)?;
+        }
+        let v=&self.fluids[0].volume;
+        let end=v.start+v.step*(v.frames()-1) as f32;
+        if time<v.start-1e-6 || time>end+1e-6 {
+            return Err(Fatal::invariant(format!("hydrodynamics: time {time} outside [{}, {end}]",v.start)));
+        }
+        self.prepare_fluid(device,time)?;
+        Ok([self.fluid_words.handle(),self.fluid_floats.handle(),self.fluid_table.handle(),self.fluid_data.handle()])
+    }
