 // `compute::atomic_float_t` is the seam's own name for both destinations'
 // element type, `float` under nvcc and on the host and `atomic_float` under
 // MSL: a `float *` here would compile on two backends and fail on the third.
+// Experimental two-sided sheet drag in SI units. Geometry is evaluated at the
+// current Newton iterate; the PSD tangent lags geometry and sampled flow.
+[[seam::device_fn]] inline void hydrodynamic_sheet_embed(
+    const Vec3f &x0, const Vec3f &x1, const Vec3f &x2,
+    const Vec3f &current0, const Vec3f &current1, const Vec3f &current2,
+    const Vec3u &face_vertex, float dt, float rho, float cn, float ct,
+    float wet, float ux, float uy, float uz,
+    compute::atomic_float_t *force, const unsigned *index,
+    const unsigned *offset, compute::atomic_float_t *value,
+    unsigned row_count, DiagHandle diag, unsigned element) {
+    const Vec3f cross = (x1-x0).cross(x2-x0);
+    const float twice_area = cross.norm();
+    if (rho <= 0.0f || wet <= 0.0f || twice_area <= 0.0f) return;
+    const Vec3f n = cross / twice_area;
+    const Vec3f velocity = (x0+x1+x2-current0-current1-current2)/(3.0f*dt);
+    const Vec3f relative = Vec3f(ux,uy,uz)-velocity;
+    const float normal_speed = n.dot(relative);
+    const Vec3f tangent = relative-normal_speed*n;
+    const float speed = tangent.norm();
+    const float factor = 0.25f*rho*twice_area*wet;
+    const Vec3f total = factor*(cn*fmath::abs(normal_speed)*normal_speed*n+ct*speed*tangent);
+    const Mat3x3f nn = n*n.transpose();
+    Mat3x3f damping = 2.0f*factor*cn*fmath::abs(normal_speed)*nn;
+    if (speed > 0.0f) damping += factor*ct*(speed*(Mat3x3f::Identity()-nn)+tangent*tangent.transpose()/speed);
+    const bool finite = !fmath::isnan(total[0]) && !fmath::isinf(total[0]) &&
+        !fmath::isnan(total[1]) && !fmath::isinf(total[1]) &&
+        !fmath::isnan(total[2]) && !fmath::isinf(total[2]);
+    DIAG_ASSERT4(diag, finite, total[0],total[1],total[2],static_cast<float>(element));
+    if (!finite) return;
+    Mat3x3f gradient;
+    Mat9x9f hessian = Mat9x9f::Zero();
+    for (unsigned a=0; a<3; ++a) {
+        gradient.col(a) = -total/3.0f;
+        for (unsigned b=0; b<3; ++b)
+            hessian.block<3,3>(3*a,3*b) = damping/(9.0f*dt);
+    }
+    face_atomic_embed_force(face_vertex, gradient, force);
+    face_atomic_push_hessian(face_vertex, hessian,index,offset,value,row_count,diag,element);
+}
